rules_version = '2';

// Reglas de seguridad de Firestore para Les Gates.
// Se pegan en Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Tiene que coincidir con ADMIN_EMAILS en comun.js
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['bm.blancom@gmail.com', 'barbarabmontero@gmail.com'];
    }

    function soyParticipante(rid, pid) {
      return signedIn()
        && get(/databases/$(database)/documents/recorridos/$(rid)/participantes/$(pid)).data.get('uid', null) == request.auth.uid;
    }

    // Un recorrido está abierto mientras está activo, publicado y no pasó su día de gracia (el día
    // siguiente al último). Cierra a las 06:00 UTC del día después del de gracia = 03:00 en Argentina.
    // Cerrado, archivado o borrador: los participantes solo pueden mirar; el admin puede todo.
    function abierto(rid) {
      let r = get(/databases/$(database)/documents/recorridos/$(rid)).data;
      let f = r.get('fechaInicio', '');
      return r.get('activo', true) == true
        && r.get('borrador', false) != true
        && (f == '' || request.time < timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2])) + duration.value((r.get('dias', 3) + 1) * 24 + 6, 'h'));
    }

    // Solo las 7 tareas reales, en un día que exista dentro del recorrido
    function tareaValida(rid) {
      return request.resource.data.keys().hasOnly(['dia', 'key', 'pid', 'nombre', 'uid', 'creado'])
        && request.resource.data.key in ['milo_seco_1', 'milo_seco_2', 'milo_humedo', 'zoe_seco_1', 'zoe_seco_2', 'zoe_humedo', 'piedras']
        && request.resource.data.dia is int
        && request.resource.data.dia >= 1
        && request.resource.data.dia <= get(/databases/$(database)/documents/recorridos/$(rid)).data.dias;
    }

    function comentarioValido() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 2000;
    }

    function conGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Código personal de un participante (lo genera el admin; nadie más lo puede leer)
    function codigoDe(rid, pid) {
      return get(/databases/$(database)/documents/recorridos/$(rid)/codigos/$(pid)).data.codigo;
    }

    // "2026-10-10" -> timestamp de ese día a las 00:00 UTC
    function fechaTs(f) {
      return timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2]));
    }

    // Turno válido: un día dentro del recorrido, con nombre y comentario de largo razonable
    function turnoValido(rid, fecha) {
      let r = get(/databases/$(database)/documents/recorridos/$(rid)).data;
      let d = request.resource.data;
      return d.keys().hasOnly(['fecha', 'pid', 'nombre', 'comentario', 'uid', 'actualizado'])
        && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.fecha == fecha
        && d.uid == request.auth.uid
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
        && d.comentario is string && d.comentario.size() <= 400
        && fechaTs(fecha) >= fechaTs(r.fechaInicio)
        && fechaTs(fecha) < fechaTs(r.fechaInicio) + duration.value(r.dias * 24, 'h');
    }

    // Los días que ya pasaron quedan fijos: se puede tocar hasta las 03:00 UTC del día siguiente
    // (= medianoche en Argentina)
    function diaSinPasar(fecha) {
      return request.time < fechaTs(fecha) + duration.value(27, 'h');
    }

    function comentarioPropio() {
      return signedIn() && resource.data.get('uid', null) == request.auth.uid;
    }

    match /recorridos/{rid} {
      allow read: if true;
      allow write: if isAdmin();

      match /participantes/{pid} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          // Vincular tu cuenta de Google a un nombre libre de la lista
          || (conGoogle()
              && resource.data.get('uid', null) == null
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'reclamado']))
          // Entrar con el código personal: en el mismo lote se escribe ingresos/{uid} con el código,
          // que tiene que coincidir con el del participante (vale aunque el nombre ya esté vinculado:
          // así se puede entrar desde otro celular)
          || (signedIn()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'reclamado'])
              && getAfter(/databases/$(database)/documents/recorridos/$(rid)/ingresos/$(request.auth.uid)).data.pid == pid
              && getAfter(/databases/$(database)/documents/recorridos/$(rid)/ingresos/$(request.auth.uid)).data.codigo == codigoDe(rid, pid))
          // Guardar tus propias preferencias (recordatorios, pop-ups vistos)
          // Marcar avisos como vistos: siempre
          || (signedIn()
              && resource.data.get('uid', null) == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vioPopupGlobal', 'popupPersonal', 'vioCierre']))
          // Recordatorios y "Terminé mis días": solo con el recorrido abierto
          || (signedIn()
              && resource.data.get('uid', null) == request.auth.uid
              && abierto(rid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notif', 'vioPopupGlobal', 'popupPersonal', 'vioCierre', 'cierre', 'actualizado']));
      }

      // Checklist compartido: cada tarea de cada día es un documento "dia_key".
      // Solo se tilda si nadie la tildó antes (create) y solo la destilda quien la tildó.
      match /tareas/{tid} {
        allow read: if true;
        allow create: if isAdmin()
          || (soyParticipante(rid, request.resource.data.pid)
              && abierto(rid)
              && tareaValida(rid)
              && request.resource.data.uid == request.auth.uid
              && tid == string(request.resource.data.dia) + '_' + request.resource.data.key);
        allow update: if isAdmin();
        allow delete: if isAdmin() || (soyParticipante(rid, resource.data.pid) && abierto(rid));
      }

      // Turnos: un documento por fecha. Solo se toma un día libre (create); después solo lo cambia
      // o lo libera quien lo tomó (o el admin)
      match /turnos/{fecha} {
        allow read: if true;
        allow create: if isAdmin()
          || (soyParticipante(rid, request.resource.data.pid)
              && abierto(rid)
              && turnoValido(rid, fecha)
              && diaSinPasar(fecha));
        allow update: if isAdmin()
          || (soyParticipante(rid, resource.data.pid)
              && request.resource.data.pid == resource.data.pid
              && abierto(rid)
              && turnoValido(rid, fecha)
              && diaSinPasar(fecha));
        allow delete: if isAdmin()
          || (soyParticipante(rid, resource.data.pid)
              && abierto(rid)
              && diaSinPasar(fecha));
      }

      // Códigos personales: solo el admin los ve y los cambia
      match /codigos/{pid} {
        allow read, write: if isAdmin();
      }

      // Intento de entrada con código: cada uno escribe el suyo; solo vale si el código es correcto
      match /ingresos/{uid} {
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['pid', 'codigo'])
          && request.resource.data.codigo == codigoDe(rid, request.resource.data.pid);
        allow read, delete: if isAdmin();
      }

      match /comentarios/{cid} {
        allow read: if true;
        allow create: if signedIn() && comentarioValido() && (isAdmin() || abierto(rid));
        allow update: if (isAdmin() && request.resource.data.mensaje is string)
          || (comentarioPropio() && comentarioValido() && abierto(rid));
        allow delete: if isAdmin() || (comentarioPropio() && abierto(rid));
      }
    }

    // Muro global
    match /comentarios/{cid} {
      allow read: if true;
      allow create: if signedIn() && comentarioValido();
      allow update: if (isAdmin() && request.resource.data.mensaje is string)
        || (comentarioPropio() && comentarioValido());
      allow delete: if isAdmin() || comentarioPropio();
    }

    // Ranking global (consultas sobre todos los recorridos)
    match /{path=**}/participantes/{pid} {
      allow read: if true;
    }
    match /{path=**}/tareas/{tid} {
      allow read: if true;
    }
  }
}
