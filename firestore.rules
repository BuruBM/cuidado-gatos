rules_version = '2';

// Reglas de seguridad de Firestore para Les Gates.
// Se pegan en Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Tiene que coincidir con ADMIN_EMAILS en comun.js
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['bm.blancom@gmail.com', 'barbarabmontero@gmail.com'];
    }

    function soyParticipante(rid, pid) {
      return signedIn()
        && get(/databases/$(database)/documents/recorridos/$(rid)/participantes/$(pid)).data.get('uid', null) == request.auth.uid;
    }

    // Solo las 7 tareas reales, en un día que exista dentro del recorrido
    function tareaValida(rid) {
      return request.resource.data.keys().hasOnly(['dia', 'key', 'pid', 'nombre', 'uid', 'creado'])
        && request.resource.data.key in ['milo_seco_1', 'milo_seco_2', 'milo_humedo', 'zoe_seco_1', 'zoe_seco_2', 'zoe_humedo', 'piedras']
        && request.resource.data.dia is int
        && request.resource.data.dia >= 1
        && request.resource.data.dia <= get(/databases/$(database)/documents/recorridos/$(rid)).data.dias;
    }

    function comentarioValido() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 2000;
    }

    function comentarioPropio() {
      return signedIn() && resource.data.get('uid', null) == request.auth.uid;
    }

    match /recorridos/{rid} {
      allow read: if true;
      allow write: if isAdmin();

      match /participantes/{pid} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          // Vincular tu cuenta de Google a un nombre libre de la lista
          || (signedIn()
              && resource.data.get('uid', null) == null
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'reclamado']))
          // Guardar tus propias preferencias (recordatorios, pop-ups vistos)
          || (signedIn()
              && resource.data.get('uid', null) == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notif', 'vioPopupGlobal', 'popupPersonal', 'vioCierre', 'cierre', 'actualizado']));
      }

      // Checklist compartido: cada tarea de cada día es un documento "dia_key".
      // Solo se tilda si nadie la tildó antes (create) y solo la destilda quien la tildó.
      match /tareas/{tid} {
        allow read: if true;
        allow create: if isAdmin()
          || (soyParticipante(rid, request.resource.data.pid)
              && tareaValida(rid)
              && request.resource.data.uid == request.auth.uid
              && tid == string(request.resource.data.dia) + '_' + request.resource.data.key);
        allow update: if isAdmin();
        allow delete: if isAdmin() || soyParticipante(rid, resource.data.pid);
      }

      match /comentarios/{cid} {
        allow read: if true;
        allow create: if signedIn() && comentarioValido();
        allow update: if comentarioPropio() && comentarioValido();
        allow delete: if isAdmin() || comentarioPropio();
      }
    }

    // Muro global
    match /comentarios/{cid} {
      allow read: if true;
      allow create: if signedIn() && comentarioValido();
      allow update: if comentarioPropio() && comentarioValido();
      allow delete: if isAdmin() || comentarioPropio();
    }

    // Ranking global (consultas sobre todos los recorridos)
    match /{path=**}/participantes/{pid} {
      allow read: if true;
    }
    match /{path=**}/tareas/{tid} {
      allow read: if true;
    }
  }
}
